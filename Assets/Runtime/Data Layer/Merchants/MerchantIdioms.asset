%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 995d9182768bbb54c911709be24600e0, type: 3}
  m_Name: MerchantIdioms
  m_EditorClassIdentifier: Project.Runtime::DumyatRuntime.MerchantIdiomsSO
  _idioms:
  - english: "Take your time, sir. My father used to say the man who rushes a deal arrives first \u2014 at nothing."
    arabic: "\u0639\u0644\u0649 \u0645\u0647\u0644\u0643 \u064A\u0627 \u0631\u064A\u0633. \u0627\u0628\u0648\u064A\u0627 \u0643\u0627\u0646 \u0628\u064A\u0642\u0648\u0644 \u0627\u0644\u0644\u064A \u0628\u064A\u0633\u062A\u0639\u062C\u0644 \u0641\u064A \u0627\u0644\u0628\u064A\u0639\u0629 \u0628\u064A\u0648\u0635\u0644 \u0627\u0644\u0627\u0648\u0644\u060C \u0628\u0633 \u0645\u0628\u064A\u0644\u0627\u0642\u064A\u0634 \u062D\u0627\u062C\u0629 \u0645\u0633\u062A\u0646\u064A\u0627\u0647."
  - english: "My wife says I talk too much while I'm working. She also says I talk too much while I'm sleeping, so I've stopped taking it personally."
    arabic: "\u0645\u0631\u0627\u062A\u064A \u0628\u062A\u0642\u0648\u0644 \u0627\u0646\u064A \u0628\u062A\u0643\u0644\u0645 \u0643\u062A\u064A\u0631 \u0648\u0627\u0646\u0627 \u0634\u063A\u0627\u0644. \u0648\u0628\u062A\u0642\u0648\u0644 \u0643\u0645\u0627\u0646 \u0627\u0646\u064A \u0628\u062A\u0643\u0644\u0645 \u0648\u0627\u0646\u0627 \u0646\u0627\u064A\u0645\u060C \u0641\u0627\u0646\u0627 \u0628\u0642\u064A\u062A \u0645\u0634 \u0648\u0627\u062E\u062F\u0647\u0627 \u0639\u0644\u0649 \u0646\u0641\u0633\u064A."
  - english: "Money is like a cat, sir \u2014 it comes to whoever isn't chasing it, and it sits in the lap of whoever isn't looking."
    arabic: "\u0627\u0644\u0641\u0644\u0648\u0633 \u0632\u064A \u0627\u0644\u0642\u0637\u0629 \u064A\u0627 \u0631\u064A\u0633\u060C \u0628\u062A\u064A\u062C\u064A \u0644\u0644\u064A \u0645\u0634 \u062C\u0627\u0631\u064A \u0648\u0631\u0627\u0647\u0627\u060C \u0648\u0628\u062A\u0642\u0639\u062F \u0641\u064A \u062D\u0636\u0646 \u0627\u0644\u0644\u064A \u0645\u0634 \u0648\u0627\u062E\u062F \u0628\u0627\u0644\u0647."
  - english: "Whoever wakes before the sun eats before everyone. Whoever wakes after the sun eats what's left \u2014 and in my house, what's left is nothing."
    arabic: "\u0627\u0644\u0644\u064A \u064A\u0635\u062D\u0649 \u0642\u0628\u0644 \u0627\u0644\u0634\u0645\u0633 \u064A\u0627\u0643\u0644 \u0642\u0628\u0644 \u0627\u0644\u0646\u0627\u0633. \u0648\u0627\u0644\u0644\u064A \u064A\u0635\u062D\u0649 \u0628\u0639\u062F \u0627\u0644\u0634\u0645\u0633 \u064A\u0627\u0643\u0644 \u0627\u0644\u0628\u0627\u0642\u064A\u060C \u0648\u0627\u0644\u0628\u0627\u0642\u064A \u0641\u064A \u0628\u064A\u062A\u0646\u0627 \u0645\u0641\u064A\u0634."
  - english: "Bless your hands. A man's hands tell you more about him than his tongue does \u2014 and they lie a great deal less."
    arabic: "\u062A\u0633\u0644\u0645 \u0627\u064A\u062F\u0643. \u0627\u064A\u062F \u0627\u0644\u0631\u0627\u062C\u0644 \u0628\u062A\u062D\u0643\u064A \u0639\u0646\u0647 \u0627\u0643\u062A\u0631 \u0645\u0646 \u0644\u0633\u0627\u0646\u0647\u060C \u0648\u0643\u0645\u0627\u0646 \u0628\u062A\u0643\u062F\u0628 \u0627\u0642\u0644 \u0628\u0643\u062A\u064A\u0631."
  - english: "Patience is bitter, they say, but nobody ever complained about its fruit. My mother-in-law is proof of the first half. God keep her \u2014 and keep her far."
    arabic: "\u0628\u064A\u0642\u0648\u0644\u0648\u0627 \u0627\u0644\u0635\u0628\u0631 \u0645\u0631\u060C \u0628\u0633 \u0645\u062D\u062F\u0634 \u0627\u0634\u062A\u0643\u0649 \u0645\u0646 \u062A\u0645\u0631\u062A\u0647. \u0648\u062D\u0645\u0627\u062A\u064A \u062F\u0644\u064A\u0644 \u0639\u0644\u0649 \u0627\u0644\u0646\u0635 \u0627\u0644\u0627\u0648\u0644. \u0631\u0628\u0646\u0627 \u064A\u062F\u064A\u0647\u0627 \u0627\u0644\u0635\u062D\u0629 \u0648\u064A\u062F\u064A\u0647\u0627 \u0628\u0639\u062F."
  - english: "Sit down, sit down. A deal made standing up is a deal one of us goes home and regrets."
    arabic: "\u0627\u0642\u0639\u062F \u0627\u0642\u0639\u062F. \u0627\u0644\u0628\u064A\u0639\u0629 \u0627\u0644\u0644\u064A \u0628\u062A\u062A\u0639\u0645\u0644 \u0648\u0648\u0642\u0641\u060C \u0648\u0627\u062D\u062F \u0641\u064A\u0646\u0627 \u0644\u0627\u0632\u0645 \u064A\u0631\u0648\u062D \u0627\u0644\u0628\u064A\u062A \u0646\u062F\u0645\u0627\u0646 \u0639\u0644\u064A\u0647\u0627."
  - english: "Here in Damietta we don't say good morning, we say \"tea?\" And if a man turns down tea twice, I start checking whether he's really from here."
    arabic: "\u0627\u062D\u0646\u0627 \u0641\u064A \u062F\u0645\u064A\u0627\u0637 \u0645\u0628\u0646\u0642\u0648\u0644\u0634 \u0635\u0628\u0627\u062D \u0627\u0644\u062E\u064A\u0631\u060C \u0628\u0646\u0642\u0648\u0644 \u0634\u0627\u064A\u061F \u0648\u0644\u0648 \u0627\u0644\u0631\u0627\u062C\u0644 \u0631\u0641\u0636 \u0627\u0644\u0634\u0627\u064A \u0645\u0631\u062A\u064A\u0646\u060C \u0627\u0628\u0642\u0649 \u0627\u062A\u0623\u0643\u062F \u0647\u0648 \u0645\u0646 \u0647\u0646\u0627 \u0627\u0635\u0644\u0627 \u0648\u0644\u0627 \u0644\u0623."
  - english: "Cheap is expensive twice over, sir. Once when you buy it, and once again when your wife looks at it."
    arabic: "\u0627\u0644\u0631\u062E\u064A\u0635 \u063A\u0627\u0644\u064A \u0645\u0631\u062A\u064A\u0646 \u064A\u0627 \u0631\u064A\u0633. \u0645\u0631\u0629 \u0648\u0627\u0646\u062A \u0628\u062A\u0634\u062A\u0631\u064A\u0647\u060C \u0648\u0645\u0631\u0629 \u062A\u0627\u0646\u064A\u0629 \u0644\u0645\u0627 \u0645\u0631\u0627\u062A\u0643 \u062A\u0628\u0635\u0644\u0647."
  - english: "God provides, praise be to Him. Though I'll note He has never once carried a crate up the stairs with me."
    arabic: "\u0631\u0628\u0646\u0627 \u0628\u064A\u0631\u0632\u0642 \u0648\u0627\u0644\u062D\u0645\u062F \u0644\u0644\u0647. \u0628\u0633 \u0647\u0642\u0648\u0644\u0643 \u062D\u0627\u062C\u0629\u060C \u0639\u0645\u0631\u0647 \u0645\u0627 \u0634\u0627\u0644 \u0645\u0639\u0627\u064A\u0627 \u0635\u0646\u062F\u0648\u0642 \u0639\u0644\u0649 \u0627\u0644\u0633\u0644\u0645 \u0648\u0644\u0627 \u0645\u0631\u0629."
  - english: "A fair scale feeds a house longer than a clever one. The clever scale feeds you for a month, then feeds the whole street gossip for a year."
    arabic: "\u0627\u0644\u0645\u064A\u0632\u0627\u0646 \u0627\u0644\u0639\u062F\u0644 \u0628\u064A\u0639\u064A\u0634 \u0627\u0644\u0628\u064A\u062A \u0627\u0643\u062A\u0631 \u0645\u0646 \u0627\u0644\u0645\u064A\u0632\u0627\u0646 \u0627\u0644\u0634\u0627\u0637\u0631. \u0627\u0644\u0645\u064A\u0632\u0627\u0646 \u0627\u0644\u0634\u0627\u0637\u0631 \u0628\u064A\u0627\u0643\u0644\u0643 \u0634\u0647\u0631\u060C \u0648\u0628\u0639\u062F\u064A\u0646 \u064A\u0623\u0643\u0644 \u0627\u0644\u0634\u0627\u0631\u0639 \u0643\u0644\u0627\u0645 \u0633\u0646\u0629."
  - english: "My neighbour bought a donkey to save on transport. Now he has transport, and a second mouth that complains louder than he does."
    arabic: "\u062C\u0627\u0631\u064A \u0627\u0634\u062A\u0631\u0649 \u062D\u0645\u0627\u0631 \u0639\u0634\u0627\u0646 \u064A\u0648\u0641\u0631 \u0641\u0644\u0648\u0633 \u0627\u0644\u0646\u0642\u0644. \u062F\u0644\u0648\u0642\u062A\u064A \u0639\u0646\u062F\u0647 \u0646\u0642\u0644\u060C \u0648\u0639\u0646\u062F\u0647 \u0628\u0642 \u062A\u0627\u0646\u064A \u0628\u064A\u0634\u062A\u0643\u064A \u0627\u0643\u062A\u0631 \u0645\u0646\u0647."
  - english: "Don't judge me by my shop, sir. Judge me by my word. The shop I rented \u2014 the word I was born with."
    arabic: "\u0645\u062A\u062D\u0643\u0645\u0634 \u0639\u0644\u064A\u0627 \u0628\u0627\u0644\u062F\u0643\u0627\u0646 \u064A\u0627 \u0631\u064A\u0633\u060C \u0627\u062D\u0643\u0645 \u0639\u0644\u064A\u0627 \u0628\u0643\u0644\u0645\u062A\u064A. \u0627\u0644\u062F\u0643\u0627\u0646 \u062F\u0647 \u0627\u0646\u0627 \u0645\u0633\u062A\u0623\u062C\u0631\u0647\u060C \u0627\u0645\u0627 \u0627\u0644\u0643\u0644\u0645\u0629 \u062F\u064A \u0641\u0627\u0646\u0627 \u0627\u062A\u0648\u0644\u062F\u062A \u0628\u064A\u0647\u0627."
  - english: "Everything in its season is good \u2014 except the tax man. He has never once been good, and he has never once been late."
    arabic: "\u0643\u0644 \u062D\u0627\u062C\u0629 \u0641\u064A \u0648\u0642\u062A\u0647\u0627 \u062D\u0644\u0648\u0629\u060C \u0627\u0644\u0627 \u0627\u0644\u0636\u0631\u0627\u064A\u0628. \u062F\u064A \u0639\u0645\u0631\u0647\u0627 \u0645\u0627 \u0643\u0627\u0646\u062A \u062D\u0644\u0648\u0629\u060C \u0648\u0639\u0645\u0631\u0647\u0627 \u0645\u0627 \u0627\u062A\u0623\u062E\u0631\u062A."
  - english: "Speak, take your time. My grandfather once closed a deal in eleven minutes and spent the next thirty years telling us about it."
    arabic: "\u0627\u062A\u0643\u0644\u0645 \u0639\u0644\u0649 \u0631\u0627\u062D\u062A\u0643. \u062C\u062F\u064A \u0645\u0631\u0629 \u0642\u0641\u0644 \u0628\u064A\u0639\u0629 \u0641\u064A \u0627\u062D\u062F\u0627\u0634\u0631 \u062F\u0642\u064A\u0642\u0629\u060C \u0648\u0641\u0636\u0644 \u062A\u0644\u0627\u062A\u064A\u0646 \u0633\u0646\u0629 \u0628\u064A\u062D\u0643\u064A\u0644\u0646\u0627 \u0639\u0644\u064A\u0647\u0627."
  - english: "The stingy man and the generous man both end up under the same dirt. Only one of them has people standing over it."
    arabic: "\u0627\u0644\u0628\u062E\u064A\u0644 \u0648\u0627\u0644\u0643\u0631\u064A\u0645 \u0627\u0644\u0627\u062A\u0646\u064A\u0646 \u0627\u062E\u0631\u062A\u0647\u0645 \u0646\u0641\u0633 \u0627\u0644\u062A\u0631\u0627\u0628. \u0628\u0633 \u0648\u0627\u062D\u062F \u0628\u0633 \u0641\u064A\u0647\u0645 \u0628\u064A\u0644\u0627\u0642\u064A \u0646\u0627\u0633 \u0648\u0627\u0642\u0641\u0629 \u0639\u0644\u064A\u0647."
  - english: "Whoever has no elder to advise him should go out and buy one. I'm available, sir, and my rates are very reasonable."
    arabic: "\u0627\u0644\u0644\u064A \u0645\u0627\u0644\u0648\u0634 \u0643\u0628\u064A\u0631 \u064A\u0634\u062A\u0631\u064A \u0644\u0646\u0641\u0633\u0647 \u0643\u0628\u064A\u0631. \u0648\u0627\u0646\u0627 \u0641\u0627\u0636\u064A \u064A\u0627 \u0631\u064A\u0633\u060C \u0648\u0633\u0639\u0631\u064A \u0643\u0648\u064A\u0633 \u0627\u0648\u064A."
  - english: "Never trust a man who agrees with you at the first word. Either he wasn't listening, or he's already counting your money."
    arabic: "\u0645\u062A\u062B\u0642\u0634 \u0627\u0628\u062F\u0627 \u0641\u064A \u0631\u0627\u062C\u0644 \u064A\u0648\u0627\u0641\u0642\u0643 \u0645\u0646 \u0627\u0648\u0644 \u0643\u0644\u0645\u0629. \u064A\u0627 \u0627\u0645\u0627 \u0645\u0643\u0627\u0646\u0634 \u0633\u0627\u0645\u0639\u0643\u060C \u064A\u0627 \u0627\u0645\u0627 \u0628\u064A\u0639\u062F \u0641\u0644\u0648\u0633\u0643 \u0648\u0627\u0646\u062A \u0644\u0633\u0647 \u0628\u062A\u062A\u0643\u0644\u0645."
  - english: "The world is like a cucumber, sir \u2014 one day it's in your hand, and the other day, well. My mother made me swear never to finish that one in front of a customer."
    arabic: "\u0627\u0644\u062F\u0646\u064A\u0627 \u0632\u064A \u0627\u0644\u062E\u064A\u0627\u0631\u0629 \u064A\u0627 \u0631\u064A\u0633\u060C \u064A\u0648\u0645 \u0641\u064A \u0627\u064A\u062F\u0643 \u0648\u064A\u0648\u0645... \u0627\u0645\u064A \u062D\u0644\u0641\u062A\u0646\u064A \u0639\u0645\u0631\u064A \u0645\u0627 \u0627\u0643\u0645\u0644 \u0627\u0644\u0645\u062B\u0644 \u062F\u0647 \u0642\u062F\u0627\u0645 \u0632\u0628\u0648\u0646."
  - english: "Repetition teaches even a donkey, they say. I've been doing this for thirty years \u2014 so either the proverb is wrong, or I'm the donkey."
    arabic: "\u0628\u064A\u0642\u0648\u0644\u0648\u0627 \u0627\u0644\u062A\u0643\u0631\u0627\u0631 \u064A\u0639\u0644\u0645 \u0627\u0644\u062D\u0645\u0627\u0631. \u0648\u0627\u0646\u0627 \u0628\u0642\u0627\u0644\u064A \u062A\u0644\u0627\u062A\u064A\u0646 \u0633\u0646\u0629 \u0641\u064A \u0627\u0644\u0634\u063A\u0644\u0627\u0646\u0629 \u062F\u064A\u060C \u064A\u0628\u0642\u0649 \u064A\u0627 \u0627\u0644\u0645\u062B\u0644 \u063A\u0644\u0637 \u064A\u0627 \u0627\u0646\u0627 \u0627\u0644\u062D\u0645\u0627\u0631."
  _chance: 0.35
  _maxDeceptionRate: 0.55
  _minPatienceLevel: 4
