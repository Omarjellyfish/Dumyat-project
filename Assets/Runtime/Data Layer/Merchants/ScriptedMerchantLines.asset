MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad210a911d5b4c50994f6c912ce60367, type: 3}
  m_Name: ScriptedMerchantLines
  m_EditorClassIdentifier:
  _welcome:
  - english: "Welcome, sir! Put the fish you want to sell on the scale and let me have a look."
    arabic: ""
  - english: "Ahlan wa sahlan! Rest your catch on the scale and we'll talk numbers."
    arabic: ""
  - english: "Peace be upon you, my friend. Lay the fish on the scale so I can price them."
    arabic: ""
  - english: "Come in, come in! Set your fish on the scale and let's see what you've brought."
    arabic: ""
  - english: "Good morning, captain! Put the whole catch on the scale for me."
    arabic: ""
  - english: "Welcome to my stall! Drop your fish on the scale and I'll weigh them up."
    arabic: ""
  - english: "Ah, a fisherman! Place your catch on the scale and let me look it over."
    arabic: ""
  - english: "Blessings on your hands, sir. Lay the fish on the scale and we'll begin."
    arabic: ""
  - english: "Welcome, welcome! Put the fish on the scale and let me judge the day's catch."
    arabic: ""
  - english: "Marhaba! Set your fish on the scale so I can give you a fair price."
    arabic: ""
  - english: "Step up, my friend! Rest the catch on the scale and let's do business."
    arabic: ""
  - english: "Fresh from the sea? Put it all on the scale and I'll take a look."
    arabic: ""
  - english: "Welcome, brother. Lay your fish on the scale and let me see the quality."
    arabic: ""
  - english: "A fine day for fish! Set your catch on the scale for me, please."
    arabic: ""
  - english: "Come closer, captain. Put the fish on the scale and we'll settle a price."
    arabic: ""
  - english: "Ahlan! Whatever you caught, put it on the scale and let me weigh it."
    arabic: ""
  - english: "Welcome to El Borg's finest stall. Rest your fish on the scale."
    arabic: ""
  - english: "Good to see you, sir. Place the catch on the scale and let me have a look."
    arabic: ""
  - english: "Bring it here! Set the fish on the scale and I'll tell you what it's worth."
    arabic: ""
  - english: "Peace upon you. Put your fish on the scale and we'll see what we can do."
    arabic: ""
  - english: "Welcome, my friend. Lay every fish on the scale and I'll price the lot."
    arabic: ""
  - english: "Ah, a good catch by the look of you! Put it on the scale for me."
    arabic: ""
  - english: "Come, come! Set your fish on the scale and don't be shy about it."
    arabic: ""
  - english: "Sabah el kheir, captain. Rest the catch on the scale, please."
    arabic: ""
  - english: "Welcome! I've been waiting for a fisherman like you. Fish on the scale, please."
    arabic: ""
  - english: "Marhaba, sir. Put your catch on the scale and let me weigh it properly."
    arabic: ""
  - english: "You look like you've had luck at sea. Set the fish on the scale."
    arabic: ""
  - english: "Welcome to the market. Lay your fish on the scale and we'll talk."
    arabic: ""
  - english: "Ahlan wa sahlan, brother. Place the whole catch on the scale for me."
    arabic: ""
  - english: "Come in from the sun! Put your fish on the scale and let me look."
    arabic: ""
  - english: "A warm welcome, captain. Rest your fish on the scale, please."
    arabic: ""
  - english: "Fresh fish, fresh money! Set your catch on the scale for me."
    arabic: ""
  - english: "Welcome, friend of the sea. Put the fish on the scale and I'll weigh it."
    arabic: ""
  - english: "Good day to you! Lay the catch on the scale and let me have a look."
    arabic: ""
  - english: "Come here, my friend. Set your fish on the scale so I can price them."
    arabic: ""
  - english: "Welcome, welcome, don't be shy. Put your catch on the scale."
    arabic: ""
  - english: "Peace be upon you, captain. Rest the fish on the scale and we'll begin."
    arabic: ""
  - english: "Ah, business at last! Place your fish on the scale for me, please."
    arabic: ""
  - english: "Welcome to my corner of the market. Set the catch on the scale."
    arabic: ""
  - english: "Ahlan! Put every last fish on the scale and let me judge them."
    arabic: ""
  - english: "Good morning, my friend. Lay the fish on the scale and we'll talk price."
    arabic: ""
  - english: "You honor my stall, captain. Rest your catch on the scale, please."
    arabic: ""
  - english: "Come, let me see the sea's gift. Put the fish on the scale for me."
    arabic: ""
  - english: "Welcome! A fisherman is always welcome here. Fish on the scale, please."
    arabic: ""
  - english: "Marhaba, brother. Set your catch on the scale and let's do good business."
    arabic: ""
  - english: "Blessings, captain. Put the fish on the scale and I'll weigh them fairly."
    arabic: ""
  - english: "Welcome, sir, welcome. Lay your catch on the scale and let me look."
    arabic: ""
  - english: "The sea was kind today? Set your fish on the scale and we'll see."
    arabic: ""
  - english: "Come closer, friend. Put the whole catch on the scale for me, please."
    arabic: ""
  - english: "Ahlan wa sahlan! Rest your fish on the scale and let me give you a price."
    arabic: ""
  _emptyScaleNudge:
  - english: "There's nothing on the scale yet, sir. Put your fish down first."
    arabic: ""
  - english: "The scale is empty, my friend. Place your catch, then tell me you're done."
    arabic: ""
  - english: "I see no fish yet, captain. Rest them on the scale for me."
    arabic: ""
  - english: "You haven't put anything on the scale. Go on, lay your catch down."
    arabic: ""
  _summaryIntro:
  - english: "Let me see what you've brought."
    arabic: ""
  - english: "Alright, let's have a look at the catch."
    arabic: ""
  - english: "Good, good. Here's what I can give you."
    arabic: ""
  - english: "Let me weigh it up for you."
    arabic: ""
  _catchAdded:
  - english: "Ah, you added {0}. Let me price it again."
    arabic: ""
  - english: "You put {0} on the scale. Here's the new total."
    arabic: ""
  - english: "Good, {0} as well. Let me weigh the lot again."
    arabic: ""
  _catchRemoved:
  - english: "You took {0} back. Here's the new price."
    arabic: ""
  - english: "Alright, {0} off the scale. Let me total it again."
    arabic: ""
  - english: "Fewer fish, then. Without {0}, here's what I can give."
    arabic: ""
  _scaleEmptied:
  - english: "You've cleared the scale, sir. Put the fish back and I'll price them."
    arabic: ""
  - english: "The scale is empty now. Set your catch down again and I'll take another look."
    arabic: ""
  _accepted:
  - english: "It's a deal! The catch is mine, the money is yours. God bless your livelihood."
    arabic: ""
  - english: "Sold! A pleasure doing business with you, captain."
    arabic: ""
  - english: "Agreed! Take your money and may the sea be kind to you."
    arabic: ""
  - english: "Done and done. Thank you, my friend, and come again."
    arabic: ""
  _declined:
  - english: "No deal today, sir. Try one of the others."
    arabic: ""
  - english: "As you wish, captain. Maybe another stall will suit you."
    arabic: ""
  - english: "No hard feelings, my friend. The market is full of buyers."
    arabic: ""
  - english: "Suit yourself. Come back if you change your mind."
    arabic: ""
  _gaveUp:
  - english: "Come back when you've got fish to sell, sir."
    arabic: ""
  - english: "No fish, no business. Off you go, my friend."
    arabic: ""
  - english: "I've no time to wait. Return when you're ready to sell."
    arabic: ""
