<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Runtime/UI%20Toolkit/styles/MenuStyles.uss" />

    <!-- ========================================================================================
         Shared settings page. Instantiated as a TEMPLATE inside both MainMenu.uxml and
         PauseMenu.uxml and driven by SettingsToolkitUI, rather than being its own prefab with its
         own UIDocument: a second world-space UIDocument would mean a second panel transform, a
         second raycaster and a depth-sorting fight with its parent, which looks wrong in VR.

         Element names below are the contract with SettingsToolkitUI — renaming one silently breaks
         a binding, since Q<T>() returns null rather than throwing.

         Uppercase strings are authored uppercase: UI Toolkit has no text-transform.
         ======================================================================================== -->
    <ui:VisualElement name="SettingsRoot" class="menu-page">

        <ui:VisualElement name="SettingsHeader" class="menu-header">
            <ui:Label text="SETTINGS" class="menu-title menu-title--sub" />
            <ui:Button name="SettingsBackButton" text="BACK" class="menu-btn menu-btn--compact" />
        </ui:VisualElement>

        <ui:VisualElement name="SettingsBody" class="settings-body">

            <!-- A persistent rail. The active tab takes a 3px cyan left bar, the same idiom the
                 inventory uses for a hovered row. -->
            <ui:VisualElement name="SettingsRail" class="settings-rail">
                <ui:Button name="TabAudioButton" text="AUDIO" class="settings-tab settings-tab--active" />
                <ui:Button name="TabLanguageButton" text="LANGUAGE" class="settings-tab" />
                <ui:Button name="TabVoiceButton" text="VOICE" class="settings-tab" />
                <!-- Next to VOICE because both are about the microphone, and BEFORE controls so the
                     rail runs from what the game does with sound to what it is allowed to do with
                     it. Keeping it here also leaves VOICE at index 2, which SettingsToolkitUI names
                     as the only page owning a live microphone. -->
                <ui:Button name="TabPermissionsButton" text="PERMISSIONS" class="settings-tab" />
                <ui:Button name="TabControlsButton" text="CONTROLS" class="settings-tab" />
            </ui:VisualElement>

            <ui:VisualElement name="SettingsPages" class="settings-pages">

                <!-- ============================================================ AUDIO -->
                <!-- Sliders are 0..1 to match ISettingsService; the labels beside them show 0-100. -->
                <ui:VisualElement name="AudioPage" class="settings-page settings-page--active">

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="MASTER" class="slider-label" />
                        <ui:Slider name="MasterSlider" low-value="0" high-value="1" value="1" class="slider-control" />
                        <ui:Label name="MasterValue" text="100" class="slider-value" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="MUSIC" class="slider-label" />
                        <ui:Slider name="MusicSlider" low-value="0" high-value="1" value="1" class="slider-control" />
                        <ui:Label name="MusicValue" text="100" class="slider-value" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="EFFECTS" class="slider-label" />
                        <ui:Slider name="SfxSlider" low-value="0" high-value="1" value="1" class="slider-control" />
                        <ui:Label name="SfxValue" text="100" class="slider-value" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="AMBIENCE" class="slider-label" />
                        <ui:Slider name="AmbienceSlider" low-value="0" high-value="1" value="1" class="slider-control" />
                        <ui:Label name="AmbienceValue" text="100" class="slider-value" />
                    </ui:VisualElement>

                    <ui:VisualElement class="slider-row">
                        <ui:Label text="VOICES" class="slider-label" />
                        <ui:Slider name="DialogueSlider" low-value="0" high-value="1" value="1" class="slider-control" />
                        <ui:Label name="DialogueValue" text="100" class="slider-value" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ========================================================= LANGUAGE -->
                <!-- TWO independent controls, not one three-way.

                     It used to be a single OFF / ENGLISH / العربية segment, on the reasoning that
                     an on/off plus a language picker could disagree. That held while the setting
                     only governed merchant captions. It stopped holding once language drove every
                     panel in the game: "off" is not a language, and choosing it threw the player's
                     language away and silently reverted the whole interface to English.

                     Split apart, the two cannot contradict each other — a language is always set,
                     and captions are independently on or off. -->
                <ui:VisualElement name="LanguagePage" class="settings-page">

                    <ui:Label text="LANGUAGE" class="settings-field-label" />

                    <ui:VisualElement name="LanguageSegment" class="segment-row">
                        <ui:Button name="LanguageEnglishButton" text="ENGLISH" class="segment-btn segment-btn--selected" />
                        <ui:Button name="LanguageArabicButton" text="العربية" class="segment-btn segment-btn--arabic" />
                    </ui:VisualElement>

                    <ui:Label text="MERCHANT SUBTITLES" class="settings-field-label settings-field-label--stacked" />

                    <ui:VisualElement name="SubtitleSegment" class="segment-row">
                        <ui:Button name="SubtitlesOnButton" text="ON" class="segment-btn segment-btn--selected" />
                        <ui:Button name="SubtitlesOffButton" text="OFF" class="segment-btn" />
                    </ui:VisualElement>

                    <!-- A live sample, so the Arabic font and its right-to-left shaping can be
                         checked in the headset without starting a negotiation. -->
                    <ui:VisualElement name="SubtitlePreview" class="subtitle-preview">
                        <ui:Label name="SubtitlePreviewSpeaker" text="AM HASSAN" class="subtitle-preview-speaker" />
                        <ui:Label name="SubtitlePreviewLabel" text="" class="subtitle-preview-line" />
                    </ui:VisualElement>

                    <ui:Label text="Language changes every panel in the game. Subtitles can be off in either language."
                              class="settings-note" />
                </ui:VisualElement>

                <!-- ============================================================ VOICE -->
                <!-- The merchant negotiation listens to a real microphone, so this page is where a
                     player fixes "it hears me when I am not talking" and "it never hears me".

                     Everything here already existed on VoiceCaptureController as an Inspector
                     field; the page only exposes it. The one thing that did NOT exist is an XR
                     binding for the PushToTalk action — it was Space only, so push-to-talk was
                     unreachable in a headset. See VoiceSettings.cs.

                     Built from the same .segment-row / .slider-row / .settings-note classes as the
                     pages above, so the carpentry bench re-skins it through WorkshopMenuStyles.uss
                     without a rule of its own. The input meter is the only new primitive. -->
                <ui:VisualElement name="VoicePage" class="settings-page">

                    <ui:Label text="MICROPHONE" class="settings-field-label" />

                    <ui:VisualElement name="MicModeSegment" class="segment-row">
                        <ui:Button name="MicVoiceActivityButton" text="VOICE ACTIVITY" class="segment-btn segment-btn--selected" />
                        <ui:Button name="MicPushToTalkButton" text="PUSH TO TALK" class="segment-btn" />
                    </ui:VisualElement>

                    <!-- Voice-activity only. Push-to-talk sets AutoStopOnSilence = false, so there
                         is no gate for these controls to tune. -->
                    <ui:VisualElement name="SensitivityGroup">
                        <ui:Label text="SENSITIVITY" class="settings-field-label settings-field-label--stacked" />

                        <ui:VisualElement name="SensitivitySegment" class="segment-row">
                            <ui:Button name="MicAutoButton" text="AUTO" class="segment-btn segment-btn--selected" />
                            <ui:Button name="MicManualButton" text="MANUAL" class="segment-btn" />
                        </ui:VisualElement>

                    </ui:VisualElement>

                    <!-- Push-to-talk only. A PICKER of the two free face buttons, not an open
                         rebind — see PushToTalkButton in VoiceSettings.cs for why. -->
                    <ui:VisualElement name="TalkButtonGroup">
                        <ui:Label text="TALK BUTTON" class="settings-field-label settings-field-label--stacked" />

                        <ui:VisualElement name="TalkButtonSegment" class="segment-row">
                            <ui:Button name="TalkPrimaryButton" text="A / X" class="segment-btn segment-btn--selected" />
                            <ui:Button name="TalkSecondaryButton" text="B / Y" class="segment-btn" />
                        </ui:VisualElement>

                        <!-- Kept short enough to stay on ONE line at this page width. Measured: the
                             push-to-talk state is the tallest the Voice page gets, and a note that
                             wraps to a second line is what pushes the meter off the panel. -->
                        <ui:Label text="Hold it while you speak. Space works on a keyboard."
                                  class="settings-note" />
                    </ui:VisualElement>

                    <!-- Page furniture, not a mode control: it stays put in both modes so "is my
                         mic working at all" is answerable without first guessing the right mode.
                         The gate marker is hidden in push-to-talk, where there is no gate. -->
                    <ui:VisualElement name="InputMeterBlock" class="input-meter-block">

                        <!-- The head names the device AND switches it. The two arrows are hidden
                             whenever there is only one microphone to choose from, which collapses
                             this row back to a single line of text — so a standalone headset, where
                             Microphone.devices is one entry, pays nothing for a control it cannot
                             use. The 64px ray targets are only on screen where there is a choice. -->
                        <ui:VisualElement name="InputMeterHead" class="input-meter-head">
                            <ui:VisualElement class="input-meter-device">
                                <ui:VisualElement name="InputMeterDot" class="input-meter-dot" />
                                <ui:Label name="InputMeterDevice" text="" class="input-meter-device-name" />
                            </ui:VisualElement>

                            <ui:VisualElement name="MicDeviceNav" class="device-nav-group">
                                <ui:Button name="MicDevicePrevButton" text="‹" class="device-nav" />
                                <ui:Button name="MicDeviceNextButton" text="›" class="device-nav" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="InputMeterTrack" class="input-meter">
                            <ui:VisualElement name="InputMeterFill" class="input-meter-fill" />
                            <ui:VisualElement name="InputMeterGate" class="input-meter-gate" />
                        </ui:VisualElement>

                        <!-- The manual gate lives UNDER the bar rather than in a labelled row of its
                             own further up the page. The handle then sits directly beneath the marker
                             it drives, so the two read as one control instead of two things the
                             player has to connect — and it costs 40px where the row cost 74, which is
                             what buys the device arrows above. 0..1 like the volume sliders;
                             SettingsToolkitUI scales it onto 0..SettingsKeys.MaxMicThreshold. -->
                        <ui:VisualElement name="GateRow" class="gate-row">
                            <ui:Slider name="MicThresholdSlider" low-value="0" high-value="1" value="0.04" class="slider-control gate-slider" />
                            <ui:Label name="MicThresholdValue" text="4" class="slider-value" />
                        </ui:VisualElement>

                        <ui:Label name="InputMeterCaption" text="" class="input-meter-caption" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- ====================================================== PERMISSIONS -->
                <!-- Microphone and online-AI consent, on a page of its own rather than folded into
                     VOICE. They are a different KIND of setting: everything else on this screen
                     tunes how the game behaves, and these two decide what it is allowed to do with
                     the player — which is the thing someone comes looking for on purpose, and
                     should not have to find underneath a sensitivity slider.

                     Two rows rather than one master switch, because they are two different asks —
                     "may the game listen" and "may what you said leave the headset" — and a player
                     can reasonably allow the first and refuse the second. IsVoiceModeAvailable()
                     already requires both.

                     Reuses segment-row / segment-btn from the VOICE pickers rather than introducing
                     a toggle: same shape, same 76px ray target, nothing new for the bench re-skin
                     to keep in step with. -->
                <ui:VisualElement name="PermissionsPage" class="settings-page">

                    <ui:VisualElement name="MicConsentRow" class="consent-row">
                        <ui:VisualElement class="consent-text">
                            <ui:Label text="Microphone" class="consent-name" />
                            <ui:Label text="So merchants can hear you haggle" class="consent-sub" />
                        </ui:VisualElement>
                        <ui:VisualElement class="segment-row consent-segment">
                            <ui:Button name="MicConsentAllowButton" text="ALLOW" class="segment-btn" />
                            <ui:Button name="MicConsentBlockButton" text="BLOCK" class="segment-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="AiConsentRow" class="consent-row">
                        <ui:VisualElement class="consent-text">
                            <ui:Label text="Online AI" class="consent-name" />
                            <ui:Label text="Sends what you say to be understood" class="consent-sub" />
                        </ui:VisualElement>
                        <ui:VisualElement class="segment-row consent-segment">
                            <ui:Button name="AiConsentAllowButton" text="ALLOW" class="segment-btn" />
                            <ui:Button name="AiConsentBlockButton" text="BLOCK" class="segment-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Deliberately separate from the switches: both can read ALLOW and voice still
                         be unavailable, because the network is down or the OS is holding the
                         microphone. Blaming a setting the player already got right sends them to
                         change back the one thing that was correct. -->
                    <ui:Label name="ConsentStatusLabel" text="" class="consent-status" />

                    <ui:Label text="Turning either off costs you nothing but the talking — merchants fall back to buttons, and every fish still sells."
                              class="settings-note" />
                </ui:VisualElement>

                <!-- ========================================================= CONTROLS -->
                <!-- View only: the player cannot rebind.

                     This used to be a single image sourced from MenuCatalogSO. That image was never
                     assigned, so the tab opened on an empty box — and an image is the wrong shape
                     for this anyway: it cannot be translated, it cannot be read at a glance at an
                     angle, and every edit means going back to an image editor.

                     Drawn instead, from plain elements — two controllers, a ring for each stick, a
                     nub for each trigger, and leader lines out to the labels. A controls page's real
                     job is spatial (which hand, which finger), and a list can only tell you that
                     while a diagram shows you.

                     THE GEOMETRY IS FIXED AT 524 x 280 AND CENTRED, not responsive. Every position
                     below is an absolute offset inside that box, and they only line up at that one
                     size — so the box must fit the SMALLEST panel that instances this page. That is
                     the 900 x 620 Delta menus, whose Controls page measures 545 x 447. The carpentry
                     bench's 1450 x 680 has room to spare and scales the whole box up instead (see
                     WorkshopMenuStyles.uss). Resize it and every lead has to be re-measured by hand. -->
                <ui:VisualElement name="ControlsPage" class="settings-page">

                    <ui:VisualElement name="ControlsSchematic" class="controls-schematic" picking-mode="Ignore">

                        <ui:Label text="LEFT" class="ctrl-hand ctrl-hand--left" />
                        <ui:Label text="RIGHT" class="ctrl-hand ctrl-hand--right" />

                        <ui:VisualElement class="ctrl-body ctrl-body--left" />
                        <ui:VisualElement class="ctrl-body ctrl-body--right" />

                        <ui:VisualElement class="ctrl-stick ctrl-stick--left" />
                        <ui:VisualElement class="ctrl-stick ctrl-stick--right" />

                        <ui:VisualElement class="ctrl-trigger ctrl-trigger--left" />
                        <ui:VisualElement class="ctrl-trigger ctrl-trigger--right" />

                        <ui:VisualElement class="ctrl-grip" />
                        <ui:VisualElement class="ctrl-menu" />

                        <!-- Leads run from the part outward to its label, and each one's `top` is
                             the vertical centre of the part it points at.

                             ONLY THREE PARTS PER HAND CARRY A LEAD, at 44px apart. A pin is an
                             action over a key plate, about 36px tall, so parts closer together than
                             that put their labels on top of each other — which is exactly what the
                             menu button did when it had a lead of its own. It is still drawn; it is
                             named in the footnote below instead. -->
                        <ui:VisualElement class="ctrl-lead" style="left: 122px; top: 84px; width: 18px;" />
                        <ui:VisualElement class="ctrl-lead" style="left: 122px; top: 140px; width: 18px;" />
                        <ui:VisualElement class="ctrl-lead" style="left: 122px; top: 225px; width: 18px;" />

                        <ui:VisualElement class="ctrl-lead" style="left: 380px; top: 84px; width: 18px;" />
                        <ui:VisualElement class="ctrl-lead" style="left: 380px; top: 140px; width: 18px;" />

                        <ui:VisualElement class="ctrl-pin ctrl-pin--left" style="top: 63px;">
                            <ui:Label text="Walk" class="ctrl-pin-action" />
                            <ui:Label text="STICK" class="ctrl-pin-key" />
                        </ui:VisualElement>

                        <ui:VisualElement class="ctrl-pin ctrl-pin--left" style="top: 119px;">
                            <ui:Label text="Use the tool" class="ctrl-pin-action" />
                            <ui:Label text="TRIGGER" class="ctrl-pin-key" />
                        </ui:VisualElement>

                        <ui:VisualElement class="ctrl-pin ctrl-pin--left" style="top: 204px;">
                            <ui:Label text="Pick up" class="ctrl-pin-action" />
                            <ui:Label text="GRIP" class="ctrl-pin-key" />
                        </ui:VisualElement>

                        <ui:VisualElement class="ctrl-pin ctrl-pin--right" style="top: 63px;">
                            <ui:Label text="Turn · Teleport" class="ctrl-pin-action" />
                            <ui:Label text="STICK" class="ctrl-pin-key" />
                        </ui:VisualElement>

                        <ui:VisualElement class="ctrl-pin ctrl-pin--right" style="top: 119px;">
                            <ui:Label text="Point at a panel" class="ctrl-pin-action" />
                            <ui:Label text="TRIGGER" class="ctrl-pin-key" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- The two controls with nowhere sensible to run a lead: one is a button too
                         close to its neighbours to label, the other is a gesture with no button at
                         all — and the one thing in this game nobody finds on their own. -->
                    <ui:Label text="Pause with the MENU button. Open your bag by reaching over your shoulder."
                              class="controls-gesture" />

                    <ui:Label name="ControlsHint" text="Controls cannot be changed." class="settings-note" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
