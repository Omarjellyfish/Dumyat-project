/* ============================================================================
   Shop panel — "Delta" treatment, counter layout.
   One product held large on the left, the rest of the shelf as a price list on
   the right. Shares its vocabulary with InventoryStyles.uss on purpose: same
   panel ground, same hairlines, same wallet readout, same ghost buttons.

   Authored against a 900 x 620 world-space panel. If the UIDocument's World
   Space Width/Height changes, these px values need rescaling with it.

   UI Toolkit has no box-shadow, no gradients, no backdrop-filter, no
   text-transform and NO DASHED BORDERS — the frosted look is opacity only,
   every uppercase string is authored uppercase in the UXML, and the empty
   icon well is a solid hairline plus a centred glyph rather than a dashed
   drop-zone.
   ============================================================================ */

/* ---------------------------------------------------------------- Panel -- */
.shop-panel {
    background-color: rgba(8, 26, 34, 0.84);
    border-width: 2px;
    border-color: rgba(120, 228, 236, 0.42);
    border-radius: 22px;
    padding: 28px 32px;
    width: 100%;
    height: 100%;
}

/* --------------------------------------------------------------- Header -- */
.shop-header {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 16px;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 228, 236, 0.2);
}

.shop-titleblock {
    flex-direction: column;
}

/* The shop's own name, small above the generic title. Hidden by the controller
   when Shop._shopName is blank, which leaves a header identical to the inventory's. */
.shop-kicker {
    font-size: 16px;
    letter-spacing: 5px;
    color: rgba(214, 246, 250, 0.55);
    margin: 0 0 6px 0;
    padding: 0;
}

.shop-title {
    font-size: 32px;
    color: #D6F6FA;
    letter-spacing: 9px;
    /* align-self must stay `auto`: `center` fights the header row's
       justify-content and pushes the wallet readout out of place. */
    align-self: auto;
    margin: 0;
    padding: 0;
}

/* ------------------------------------------------- Wallet (EGP readout) -- */
.wallet-chip {
    flex-direction: column;
    align-items: flex-end;
    padding: 2px 4px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: border-color, background-color, scale;
    transition-duration: 0.18s;
}

.wallet-currency {
    font-size: 14px;
    color: rgba(214, 246, 250, 0.55);
    letter-spacing: 4px;
    margin: 0;
    padding: 0;
}

.wallet-balance {
    font-size: 44px;
    color: #8DEBAF;
    margin: 0;
    padding: 0;
}

/* Transient feedback, added then removed by ShopToolkitUI. A refused purchase
   never gets one: nothing was spent, so nothing should animate. */
.wallet-chip--loss {
    border-color: rgba(255, 155, 138, 0.85);
    background-color: rgba(255, 155, 138, 0.14);
    scale: 0.96;
}

.wallet-chip--gain {
    border-color: rgba(141, 235, 175, 0.85);
    background-color: rgba(141, 235, 175, 0.14);
    scale: 1.06;
}

/* ----------------------------------------------------------------- Body -- */
.shop-split {
    flex-direction: row;
    flex-grow: 1;
}

/* ------------------------------------------------------- Icon wells -- */
/* One element, two sizes. The controller assigns background-image from
   ItemData.Icon; background-size stays `contain` so a non-square sprite
   letterboxes inside the well instead of stretching. */
.icon-well {
    background-color: rgba(103, 221, 232, 0.1);
    border-width: 2px;
    border-color: rgba(120, 228, 236, 0.35);
    border-radius: 8px;
    background-size: contain;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.icon-well--hero {
    width: 196px;
    height: 196px;
}

.icon-well--row {
    width: 46px;
    height: 46px;
    border-radius: 6px;
    margin-right: 12px;
}

.icon-well-empty {
    flex-direction: column;
    align-items: center;
}

.icon-well-mark {
    font-size: 34px;
    color: rgba(120, 228, 236, 0.5);
    margin: 0;
    padding: 0;
}

.icon-well-mark--row {
    font-size: 20px;
}

.icon-well-label {
    font-size: 14px;
    letter-spacing: 3px;
    color: rgba(214, 246, 250, 0.4);
    margin: 8px 0 0 0;
    padding: 0;
}

/* -------------------------------------------------------- Focus (left) -- */
.shop-focus {
    flex-grow: 1;
    flex-direction: column;
    padding-right: 24px;
}

.focus-top {
    flex-direction: row;
    align-items: flex-start;
}

.focus-heading {
    flex-direction: column;
    flex-shrink: 1;
    margin-left: 22px;
}

.focus-name {
    font-size: 38px;
    color: #EAF8FB;
    letter-spacing: 0.5px;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.focus-stock {
    font-size: 20px;
    color: rgba(214, 246, 250, 0.55);
    margin: 6px 0 0 0;
    padding: 0;
}

/* The last unit is worth flagging — cyan, the same accent the inventory uses
   for quantities. */
.focus-stock--last {
    color: #67DDE8;
}

.focus-stock--none {
    color: rgba(255, 155, 138, 0.8);
}

.focus-desc {
    font-size: 22px;
    color: rgba(214, 246, 250, 0.72);
    white-space: normal;
    margin: 20px 0 0 0;
    padding: 0;
}

.focus-foot {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: auto;
}

.price-lg {
    flex-direction: column;
    align-items: flex-start;
}

.price-lg-label {
    font-size: 14px;
    letter-spacing: 4px;
    color: rgba(214, 246, 250, 0.55);
    margin: 0;
    padding: 0;
}

.price-lg-value {
    font-size: 54px;
    color: #8DEBAF;
    margin: 0;
    padding: 0;
}

/* Coral only for a price the player cannot meet. */
.price-lg-value--short {
    color: #FF9B8A;
}

/* ------------------------------------------------------------ BUY button -- */
/* Ghost button in the cyan accent, not jade: jade stays on the numbers so the
   prices read as a column. 232 x 72 clears the project's 64px VR ray-target floor. */
.buy-btn {
    font-size: 24px;
    color: #67DDE8;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(120, 228, 236, 0.55);
    border-radius: 8px;
    min-height: 72px;
    min-width: 232px;
    padding: 10px 24px;
    margin: 0;
    letter-spacing: 2px;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.12s;
}

.buy-btn:hover {
    background-color: rgba(103, 221, 232, 0.18);
    border-color: #67DDE8;
    color: #CFF6FA;
    scale: 1.04;
}

.buy-btn:active {
    background-color: #12707C;
    border-color: #67DDE8;
    color: #FFFFFF;
    scale: 0.96;
}

/* Cannot afford it. Names the gap rather than just greying out, so the player
   knows how much more they need. */
.buy-btn--short {
    color: rgba(255, 155, 138, 0.85);
    border-color: rgba(255, 155, 138, 0.35);
    background-color: rgba(0, 0, 0, 0);
    scale: 1;
}

.buy-btn--short:hover {
    color: rgba(255, 155, 138, 0.85);
    border-color: rgba(255, 155, 138, 0.35);
    background-color: rgba(0, 0, 0, 0);
    scale: 1;
}

.buy-btn--out {
    color: rgba(214, 246, 250, 0.35);
    border-color: rgba(214, 246, 250, 0.18);
    background-color: rgba(0, 0, 0, 0);
    scale: 1;
}

.buy-btn--out:hover {
    color: rgba(214, 246, 250, 0.35);
    border-color: rgba(214, 246, 250, 0.18);
    background-color: rgba(0, 0, 0, 0);
    scale: 1;
}

/* ------------------------------------------------------- Picker (right) -- */
.shop-picker {
    width: 330px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: rgba(120, 228, 236, 0.2);
    padding-left: 22px;
}

/* Rows read as one continuous list: hairline dividers, no cards. 70px tall so a
   46px thumbnail fits and the row still clears the ray-target floor. */
.pick {
    flex-direction: row;
    align-items: center;
    min-height: 70px;
    padding: 8px 8px 8px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 228, 236, 0.14);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-left-color;
    transition-duration: 0.15s;
}

.pick:hover {
    background-color: rgba(103, 221, 232, 0.06);
}

/* Selected: the cyan bar on the left edge, matching the inventory's hover bar. */
.pick--selected {
    background-color: rgba(103, 221, 232, 0.1);
    border-left-color: #67DDE8;
}

.pick--out {
    opacity: 0.5;
}

.pick-name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 21px;
    color: #EAF8FB;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.pick-price {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
}

.pick-price-num {
    font-size: 22px;
    color: #8DEBAF;
    margin: 0;
    padding: 0;
}

.pick-price-num--short {
    color: #FF9B8A;
}

.pick-price-num--out {
    color: rgba(214, 246, 250, 0.35);
}

/* Fixed width so "EGP" forms a straight right edge down the list however many
   digits the price has. Muted rather than jade on purpose: the currency repeats
   on every row, and colouring it too would double the green on the panel and
   make the numbers harder to compare, not easier. */
.pick-price-cur {
    font-size: 15px;
    letter-spacing: 2px;
    color: rgba(214, 246, 250, 0.55);
    width: 42px;
    -unity-text-align: middle-right;
    margin: 0 0 2px 6px;
    padding: 0;
}

/* ---------------------------------------------------------- Empty state -- */
.shop-empty-hint {
    font-size: 24px;
    color: rgba(214, 246, 250, 0.45);
    -unity-text-align: middle-center;
    margin-top: 24px;
    /* ShopToolkitUI flips this to Flex when the catalogue is empty. */
    display: none;
}
