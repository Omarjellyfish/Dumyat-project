/* ============================================================================
   Workshop — the carpentry bench's own treatment for the shared settings page.

   A DELIBERATE EXCEPTION to the project's Delta rule (CLAUDE.md ▸ "UI theme").
   Delta is frosted deep-water glass: cyan on near-black, a panel that floats in
   front of whatever is behind it. That is right for a panel hanging in the air
   and wrong here, because this page lies FLAT ON THE WORKBENCH. A dark glass
   card sitting on a lit oak plank reads as a tablet someone left on the table,
   not as part of the table.

   So the table is the window. The ground is mostly transparent, the palette is
   the room's own — scorched brown, bone, ember amber, iron — and the page reads
   as an area branded into the bench top beside the nails.

   SCOPED UNDER .workshop ON PURPOSE. SettingsPage.uxml is shared with the main
   menu and the pause menu, which must both stay Delta. Every rule here is a
   descendant selector, so it outranks the matching MenuStyles.uss rule by
   specificity no matter which sheet loads first, and reaches nothing outside
   this panel.

   Sizing is inherited from MenuStyles.uss and left alone where it already meets
   the VR floor (body >= 26px, headers >= 32px, ray targets >= 64px tall). Only
   colour, decoration and the few sizes that need help at this viewing angle are
   restated.
   ============================================================================ */

/* -------------------------------------------------------------- The page -- */
/* NO GROUND AND NO BORDER. The bench is the frame.

   An earlier pass put a 0.38 wash and a scored border here, on the reasoning
   that the text needed a guaranteed ground to sit on. That reasoning was sound
   and the result still read as a card resting on the table — which is the exact
   thing this treatment exists to avoid.

   Legibility moved to where the data actually is instead: every row that carries
   a value is a branded strip with its own ground (see .slider-row and
   .controls-row below), and every loose string carries a text shadow heavy
   enough to hold against grain. Nothing floats on bare wood except headings,
   which are large enough to survive it.

   Because there is no card edge to respect, the panel can also be stretched much
   wider across the bench — the document is 1450 x 680 rather than the Delta
   menus' 900 x 620. */
.workshop {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 26px 34px;
    width: 100%;
    height: 100%;
}

/* ---------------------------------------------------------------- Header -- */
.workshop .menu-header {
    padding-bottom: 16px;
    margin-bottom: 4px;
    border-bottom-width: 2px;
    /* A scored line, the kind left by a marking knife — not a UI hairline. */
    border-bottom-color: rgba(22, 12, 3, 0.6);
}

.workshop .menu-title {
    color: #F6E7CC;
    letter-spacing: 8px;
    text-shadow: 1px 2px 2px rgba(10, 5, 0, 0.95);
}

.workshop .menu-header-note {
    color: rgba(246, 231, 204, 0.55);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

/* --------------------------------------------------------- Back / buttons -- */
/* Branded outline, filling with ember on hover — the same language as the
   labels burned into the plank a few centimetres away. */
.workshop .menu-btn {
    background-color: rgba(22, 12, 3, 0.35);
    border-width: 2px;
    border-color: rgba(255, 179, 71, 0.55);
    border-radius: 5px;
    color: #F6E7CC;
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

.workshop .menu-btn:hover {
    background-color: rgba(255, 179, 71, 0.22);
    border-color: #FFB347;
    color: #FFF2DC;
}

/* Pressed: the ember fills and the lettering goes dark, with a pale highlight
   under it so it reads as struck into hot metal. `text-shadow: none` is not
   valid USS — the property needs two or three lengths and a colour — so the
   inherited dark shadow is replaced rather than cleared. */
.workshop .menu-btn:active {
    background-color: #FFB347;
    border-color: #FFD9A0;
    color: #2A1607;
    text-shadow: 1px 1px 0 rgba(255, 226, 179, 0.75);
}

/* ------------------------------------------------------------------ Rail -- */
.workshop .settings-pages {
    border-left-width: 2px;
    border-left-color: rgba(22, 12, 3, 0.55);
}

.workshop .settings-tab {
    color: rgba(246, 231, 204, 0.6);
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 5px;
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

.workshop .settings-tab:hover {
    background-color: rgba(255, 179, 71, 0.14);
    color: #F6E7CC;
}

/* The active tab is marked the way a carpenter marks stock: a burn down one
   edge, not a filled chip. */
.workshop .settings-tab--active {
    background-color: rgba(255, 179, 71, 0.16);
    border-left-color: #FFB347;
    color: #FFF2DC;
}

/* --------------------------------------------------------------- Sliders -- */
.workshop .settings-field-label {
    color: rgba(246, 231, 204, 0.62);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

/* TOOLBOARD.
   Each control gets its own branded strip rather than sitting on a shared
   scored line — settings racked like tools on a board. It also makes every row
   a much larger, more obvious ray target, which matters more here than usual
   because the page is lying flat and is being pointed at from an angle.

   min-height stays at MenuStyles' 74px and the padding is horizontal only: five
   strips plus the header have to clear a 620px document, and vertical padding
   on each one is what pushes the audio page into an overflow. */
.workshop .slider-row {
    min-height: 74px;
    margin-bottom: 10px;
    padding: 0 16px;
    background-color: rgba(26, 15, 6, 0.42);
    border-width: 2px;
    border-color: rgba(255, 179, 71, 0.28);
    border-radius: 4px;
}

.workshop .slider-label {
    color: rgba(246, 231, 204, 0.82);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

/* A groove cut into the plank, with an iron stud riding in it. */
.workshop .slider-control .unity-base-slider__tracker {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(20, 11, 3, 0.7);
    border-width: 1px;
    border-color: rgba(255, 179, 71, 0.20);
}

.workshop .slider-control .unity-base-slider__dragger {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: #FFB347;
    border-width: 2px;
    border-color: rgba(42, 22, 7, 0.85);
    margin-top: -15px;
}

/* The value punched into an iron plate rather than glowing beside the groove.
   Flat colour, not a gradient: UI Toolkit has no gradients, and the dark border
   plus the near-black lettering is what sells it as stamped metal. Dark ink on
   pale metal needs no text shadow — the one inherited from the row would read
   as smudging. */
.workshop .slider-value {
    width: 84px;
    padding: 5px 0;
    background-color: #C9C2B6;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
    border-radius: 2px;
    color: #241503;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
}

/* -------------------------------------------------------------- Segments -- */
.workshop .segment-btn {
    background-color: rgba(22, 12, 3, 0.35);
    border-width: 2px;
    border-color: rgba(255, 179, 71, 0.40);
    border-radius: 5px;
    color: rgba(246, 231, 204, 0.6);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

/* Segments carry no bottom margin of their own in MenuStyles, which is fine on a
   panel read straight on. Flat on the bench the page is foreshortened, and the
   28px above the next field label collapses to almost nothing — so the row gets
   its own gap here. */
.workshop .segment-row {
    margin-bottom: 12px;
}

.workshop .segment-btn:hover {
    background-color: rgba(255, 179, 71, 0.16);
    color: #F6E7CC;
}

.workshop .segment-btn--selected {
    background-color: rgba(255, 179, 71, 0.26);
    border-color: #FFB347;
    color: #FFF2DC;
}

/* -------------------------------------------------- Subtitle preview box -- */
.workshop .subtitle-preview {
    border-width: 2px;
    border-color: rgba(22, 12, 3, 0.55);
    border-radius: 6px;
    background-color: rgba(18, 10, 3, 0.42);
}

.workshop .subtitle-preview-speaker {
    color: #FFB347;
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

.workshop .subtitle-preview-line {
    color: #F6E7CC;
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

.workshop .subtitle-preview-line--muted {
    color: rgba(246, 231, 204, 0.38);
}

.workshop .settings-note {
    color: rgba(246, 231, 204, 0.45);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.85);
}

/* ----------------------------------------------------------------- Voice -- */
/* The input meter re-cast for the bench. Geometry stays in MenuStyles; only
   colour changes here, so the two skins cannot drift apart.

   `.voice-group--hidden` deliberately has no counterpart — it sets `display`
   and nothing else, and layout is shared by both skins.

   The bar reads as a groove cut into the plank with ember rising in it, the
   same idiom as the sliders above. Jade would be a fourth colour on a board
   that only owns bone and ember, so "the gate is open" is carried by the pale
   BONE fill instead: dark groove, ember below the gate, bone above it. */
.workshop .device-nav {
    background-color: rgba(22, 12, 3, 0.35);
    border-color: rgba(255, 179, 71, 0.40);
    border-radius: 5px;
    color: rgba(246, 231, 204, 0.82);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

.workshop .device-nav:hover {
    background-color: rgba(255, 179, 71, 0.16);
    border-color: #FFB347;
    color: #F6E7CC;
}

.workshop .input-meter-device-name {
    color: rgba(246, 231, 204, 0.82);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

.workshop .input-meter-dot {
    background-color: rgba(255, 179, 71, 0.3);
}

.workshop .input-meter-dot--open {
    background-color: #F6E7CC;
}

.workshop .input-meter {
    background-color: rgba(20, 11, 3, 0.7);
    border-width: 1px;
    border-color: rgba(255, 179, 71, 0.20);
}

.workshop .input-meter-fill {
    background-color: #FFB347;
}

.workshop .input-meter-fill--open {
    background-color: #F6E7CC;
}

/* Dark, because it is read against ember and bone rather than against cyan. */
.workshop .input-meter-gate {
    background-color: #160C03;
}

.workshop .input-meter-gate--auto {
    background-color: rgba(22, 12, 3, 0.6);
}

.workshop .input-meter-caption {
    color: rgba(246, 231, 204, 0.45);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.85);
}

/* -------------------------------------------------------------- Controls -- */
/* The schematic re-cast in iron and ember. Geometry is untouched — every offset
   lives in MenuStyles and SettingsPage.uxml, and only colour and overall SIZE
   change here, so the two skins can never drift out of alignment.

   The 540 x 230 box is sized for the smallest panel that instances this page
   (the 900 x 620 Delta menus). On this one it would be a stamp in the middle of
   a 1450 x 680 board, so it is scaled up bodily rather than re-laid out — one
   number instead of twenty-odd offsets that would then have to agree with the
   originals forever.

   `scale` does not affect layout, so the element still reserves only its
   unscaled 280px and would grow over whatever sits below it. The vertical
   margins buy back the difference: 280 * 0.4 / 2 = 56px each side.

   1.4 rather than the 1.75 this used before the diagram was made taller — at
   280px tall, 1.75 draws 490px and the reserved height plus the footnote and
   the hint no longer clear this page. */
.workshop .controls-schematic {
    scale: 1.4 1.4;
    margin-top: 60px;
    margin-bottom: 56px;
}

.workshop .ctrl-hand {
    color: rgba(246, 231, 204, 0.55);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}

/* Dark iron against the plank, rather than a hole cut in the bench. */
.workshop .ctrl-body {
    background-color: rgba(20, 12, 5, 0.82);
    border-color: rgba(255, 179, 71, 0.4);
}

.workshop .ctrl-stick {
    background-color: rgba(12, 7, 2, 0.92);
    border-color: #FFB347;
}

.workshop .ctrl-trigger,
.workshop .ctrl-grip,
.workshop .ctrl-menu {
    background-color: rgba(12, 7, 2, 0.92);
    border-color: rgba(255, 179, 71, 0.7);
}

.workshop .ctrl-lead {
    background-color: rgba(255, 179, 71, 0.6);
}

.workshop .ctrl-pin-action {
    color: rgba(246, 231, 204, 0.9);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.92);
}

/* The binding stamped into the same pale iron as the slider readouts. Padding
   and a background turn the label into a plate; without them it is just text
   the colour of metal. Which side it hangs off is settled by align-items on the
   pin itself, in MenuStyles — it does not need repeating here. */
.workshop .ctrl-pin-key {
    padding: 2px 8px;
    background-color: #C9C2B6;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
    border-radius: 2px;
    color: #241503;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
}

.workshop .controls-gesture {
    color: rgba(246, 231, 204, 0.62);
    text-shadow: 1px 1px 2px rgba(10, 5, 0, 0.9);
}
