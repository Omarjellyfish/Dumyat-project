<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Runtime/UI%20Toolkit/DestinationBoard/DestinationBoard.uss" />

    <!-- Delta v2 "workshop drawing" — departure stubs. Authored for a 900 x 620 world-space
         panel, the same canvas as the inventory, main menu and pause menu.

         DestinationBoardUI queries HeaderLabel and DestinationContainer by name; both keep
         their names. RouteCount is additive and null-guarded on the C# side. -->
    <ui:VisualElement name="DestinationRoot" class="destination-root">

        <!-- Crop marks. -->
        <ui:VisualElement class="corner corner--tl" picking-mode="Ignore" />
        <ui:VisualElement class="corner corner--tr" picking-mode="Ignore" />
        <ui:VisualElement class="corner corner--bl" picking-mode="Ignore" />
        <ui:VisualElement class="corner corner--br" picking-mode="Ignore" />

        <ui:VisualElement class="destination-header-container">
            <ui:VisualElement class="destination-title-group">
                <ui:Label name="BoardEyebrow" text="DAMIETTA · LOCAL SERVICE" class="destination-eyebrow" />
                <ui:Label name="HeaderLabel" text="DEPARTURES" class="destination-header" />
            </ui:VisualElement>

            <ui:VisualElement class="route-readout">
                <ui:Label name="RouteCountLabel" text="ROUTES" class="route-readout-label" />
                <ui:Label name="RouteCount" text="0" class="route-readout-value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView name="DestinationContainer" class="destination-scroll" />
    </ui:VisualElement>
</ui:UXML>
