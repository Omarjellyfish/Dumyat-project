.completed-menu-container {
    width: 600px;
    height: 800px;
    background-color: #2c2c2c;
    border-radius: 16px;
    padding: 20px;
    border-width: 4px;
    border-color: #4a4a4a;
    flex-direction: column;
}

.completed-menu-header {
    color: #e0e0e0;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    border-bottom-width: 2px;
    border-bottom-color: #555555;
    padding-bottom: 10px;
}

.completed-menu-scroll-view {
    flex-grow: 1;
}

/* Completed Item Styles */
.completed-item {
    background-color: #383838;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
    border-left-width: 6px;
    border-left-color: #4caf50;
}

.completed-item-title {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.completed-item-desc {
    color: #aaaaaa;
    font-size: 14px;
    white-space: normal;
}
