    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "DrawRoundedRectangleMask",
    "m_FunctionSource": "c23d4c79c0e24bf49aaf88061e7f9cef",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Center the UVs around (0, 0)\r\nfloat2 centeredUV = UV - 0.5;\r\n\r\n// 1. Calculate standard Box/Rounded Rectangle distance field\r\nfloat2 halfSize = Size * 0.5;\r\nfloat2 d = abs(centeredUV) - halfSize + Radius;\r\nfloat dist = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - Radius;\r\n\r\n// 2. Determine which edge/side the current pixel is closest to\r\nfloat isRight  = smoothstep(0.0, 1.0, centeredUV.x / max(halfSize.x, 0.001));\r\nfloat isLeft   = smoothstep(0.0, 1.0, -centeredUV.x / max(halfSize.x, 0.001));\r\nfloat isTop    = smoothstep(0.0, 1.0, centeredUV.y / max(halfSize.y, 0.001));\r\nfloat isBottom = smoothstep(0.0, 1.0, -centeredUV.y / max(halfSize.y, 0.001));\r\n\r\n// Normalize weights so they equal 1.0 overall\r\nfloat weightSum = isRight + isLeft + isTop + isBottom;\r\nisRight  /= weightSum;\r\nisLeft   /= weightSum;\r\nisTop    /= weightSum;\r\nisBottom /= weightSum;\r\n\r\n// 3. Extract from Vector 4 (X=Left, Y=Top, Z=Right, W=Bottom)\r\nfloat localSmoothness = (EdgeSmoothness.x * isLeft) + \r\n                        (EdgeSmoothness.y * isTop) + \r\n                        (EdgeSmoothness.z * isRight) + \r\n                        (EdgeSmoothness.w * isBottom);\r\n\r\n// Ensure smoothness doesn't completely zero out to avoid division errors\r\nlocalSmoothness = max(localSmoothness, 0.0001);\r\n\r\n// 4. Output anti-aliased edge\r\nOut = 1.0 - smoothstep(-localSmoothness, localSmoothness, dist);"
}

