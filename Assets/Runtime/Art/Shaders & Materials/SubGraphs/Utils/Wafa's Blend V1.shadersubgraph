    "m_SourceType": 1,
    "m_FunctionName": "Overlay",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "$precision base = Background;\r\n$precision blend = Foreground;\r\n\r\n// Component-wise mask: 0 if base < 0.5, 1 if base >= 0.5\r\n$precision isLight = step(0.5, base);\r\n$precision isDark  = 1.0 - isLight;\r\n\r\n// Calculate both blend paths\r\n$precision darkPass  = 2.0 * base * blend;\r\n$precision lightPass = 1.0 - 2.0 * (1.0 - base) * (1.0 - blend);\r\n\r\n// Combine paths using the masks\r\nOut = (darkPass * isDark) + (lightPass * isLight);"
}

