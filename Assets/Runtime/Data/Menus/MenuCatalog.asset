  m_Script: {fileID: 11500000, guid: 5211740e8c93191438b18edf14b4db36, type: 3}
  m_Name: MenuCatalog
  m_EditorClassIdentifier: Project.Runtime::DumyatRuntime.MenuCatalogSO
  _mainMenuSceneName: MainMenu
  _newGameSceneName: Home
  _nonResumableScenes: []
  _loadingTips:
  - Merchants remember how you dealt with them. Push too hard and the next price
    will be worse.
  - Freshness moves the price more than weight does. A big old fish is still an old
    fish.
  - The Menu button on your left controller pauses at any time.
  - "Put your catch on the scale before you start haggling \u2014 an empty scale
    gives you nothing to argue with."
  - Measure twice, cut once. The saw does not accept apologies.
  - The chisel undoes a bad joint. Nothing undoes telling a merchant his fish smells.
  - Squeeze the grip to hold something. Let go to drop it. That is the entire course.
  - The validation board tells you exactly what is missing. It will not be gentle
    about it.
  - Bouri goes for 55 to 90 a kilo. Memorise that and haggle like you were born to
    it.
  - Patience catches more than speed. The water has been here a lot longer than you
    have.
  - Aim your cast at open water. Your own boat is not a fishing spot.
  - Grab the fish before it flops back in. It has done this before.
  - Every route has a code on the departure board. C1 is the workshop, R3 is where
    the fish are.
  - The bus goes where you tell it. It has no opinion on your business plan.
  - Talk to the merchant out loud. Staring at him meaningfully does not lower the
    price.
  - The merchant needs your microphone to hear you. Less sinister than it sounds.
  - Glue joins two pieces. It will just as happily join the wrong two, so aim.
  - Pick a blueprint before you start cutting. Improvising costs planks.
  - Your bag holds whatever you put in it. Revolutionary, we know.
  - Glance at your wrist when you have forgotten what you were doing.
  - The whole game speaks Arabic. Settings, Language, done.
  - Six kinds of fish out there. Learn which ones pay the rent.
  - Every slider in Settings does something. Yes, even that one.
  - Damietta has been making furniture for six hundred years. No pressure.
  - The boat takes one part per socket. It will not take two, however hard you shove.
  - Mind the furniture in your actual room. The workshop accepts no liability.
  - Accepting the first offer is allowed. It is rarely your best work.
  - Wood does not grow back on the bench. Cut like you mean it.
  - A fish caught this morning argues better than one caught yesterday.
  - If your arms ache, that is not a game mechanic. Go and sit down.
  _loadingTipsArabic:
  - "\u0627\u0644\u062A\u062C\u0627\u0631 \u0628\u064A\u0641\u062A\u0643\u0631\u0648\u0627
    \u062A\u0639\u0627\u0645\u0644\u0643 \u0645\u0639\u0627\u0647\u0645. \u0627\u0636\u063A\u0637
    \u0623\u0648\u064A \u0641\u064A \u0627\u0644\u0641\u0635\u0627\u0644 \u0648\u0627\u0644\u0633\u0639\u0631
    \u0627\u0644\u062C\u0627\u064A \u0647\u064A\u0628\u0642\u0649 \u0623\u0648\u062D\u0634."
  - "\u0627\u0644\u0637\u0632\u0627\u062C\u0629 \u0628\u062A\u062D\u0631\u0643 \u0627\u0644\u0633\u0639\u0631
    \u0623\u0643\u062A\u0631 \u0645\u0646 \u0627\u0644\u0648\u0632\u0646. \u0627\u0644\u0633\u0645\u0643\u0629
    \u0627\u0644\u0643\u0628\u064A\u0631\u0629 \u0627\u0644\u0642\u062F\u064A\u0645\u0629
    \u062A\u0641\u0636\u0644 \u0642\u062F\u064A\u0645\u0629."
  - "\u0632\u0631\u0627\u0631 \u0627\u0644\u0645\u0646\u064A\u0648 \u0641\u064A \u0627\u0644\u064A\u062F
    \u0627\u0644\u0634\u0645\u0627\u0644 \u0628\u064A\u0648\u0642\u0641 \u0627\u0644\u0644\u0639\u0628\u0629
    \u0641\u064A \u0623\u064A \u0648\u0642\u062A."
  - "\u062D\u0637 \u0635\u064A\u062F\u0643 \u0639\u0644\u0649 \u0627\u0644\u0645\u064A\u0632\u0627\u0646
    \u0642\u0628\u0644 \u0645\u0627 \u062A\u0628\u062F\u0623 \u062A\u0641\u0627\u0635\u0644
    \u2014 \u0645\u064A\u0632\u0627\u0646 \u0641\u0627\u0636\u064A \u0645\u0634 \u0647\u064A\u062F\u064A\u0643
    \u062D\u0627\u062C\u0629 \u062A\u062A\u0643\u0644\u0645 \u0628\u064A\u0647\u0627."
  - "\u0642\u064A\u0633 \u0645\u0631\u062A\u064A\u0646 \u0648\u0627\u0642\u0637\u0639
    \u0645\u0631\u0629. \u0627\u0644\u0645\u0646\u0634\u0627\u0631 \u0645\u0634 \u0628\u064A\u0642\u0628\u0644
    \u0627\u0639\u062A\u0630\u0627\u0631."
  - "\u0627\u0644\u0625\u0632\u0645\u064A\u0644 \u0628\u064A\u0641\u0643 \u0648\u0635\u0644\u0629
    \u063A\u0644\u0637. \u0628\u0633 \u0645\u0641\u064A\u0634 \u062D\u0627\u062C\u0629
    \u0628\u062A\u0635\u0644\u0651\u062D \u0625\u0646\u0643 \u062A\u0642\u0648\u0644
    \u0644\u0644\u062A\u0627\u062C\u0631 \u0625\u0646 \u0633\u0645\u0643\u0647 \u0631\u064A\u062D\u062A\u0647
    \u0648\u062D\u0634\u0629."
  - "\u062F\u0648\u0633 \u0627\u0644\u062C\u0631\u064A\u0628 \u0639\u0634\u0627\u0646
    \u062A\u0645\u0633\u0643\u060C \u0648\u0633\u064A\u0628\u0647 \u0639\u0634\u0627\u0646
    \u062A\u0633\u064A\u0628. \u0627\u0644\u0643\u0648\u0631\u0633 \u062E\u0644\u0635."
  - "\u0644\u0648\u062D\u0629 \u0627\u0644\u0645\u0631\u0627\u062C\u0639\u0629 \u0647\u062A\u0642\u0648\u0644\u0643
    \u0625\u064A\u0647 \u0627\u0644\u0644\u064A \u0646\u0627\u0642\u0635 \u0628\u0627\u0644\u0638\u0628\u0637.
    \u0648\u0645\u0634 \u0647\u062A\u062C\u0627\u0645\u0644\u0643."
  - "\u0627\u0644\u0628\u0648\u0631\u064A \u0628\u064A\u062C\u064A\u0628 \u0645\u0646
    \u0665\u0665 \u0644\u0640 \u0669\u0660 \u0627\u0644\u0643\u064A\u0644\u0648.
    \u0627\u062D\u0641\u0638\u0647\u0627 \u0648\u0641\u0627\u0635\u0644 \u0648\u0627\u0646\u062A
    \u0648\u0627\u062B\u0642."
  - "\u0627\u0644\u0635\u0628\u0631 \u0628\u064A\u0635\u0637\u0627\u062F \u0623\u0643\u062A\u0631
    \u0645\u0646 \u0627\u0644\u0633\u0631\u0639\u0629. \u0627\u0644\u0645\u064A\u0651\u0629
    \u0647\u0646\u0627 \u0645\u0646 \u0642\u0628\u0644\u0643 \u0628\u0643\u062A\u064A\u0631."
  - "\u0635\u0648\u0651\u0628 \u0639\u0644\u0649 \u0627\u0644\u0645\u064A\u0651\u0629
    \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629. \u0645\u0631\u0643\u0628\u0643
    \u0645\u0634 \u0645\u0643\u0627\u0646 \u0635\u064A\u062F."
  - "\u0627\u0645\u0633\u0643 \u0627\u0644\u0633\u0645\u0643\u0629 \u0642\u0628\u0644
    \u0645\u0627 \u062A\u0631\u062C\u0639 \u062A\u0646\u0637\u0651. \u0647\u064A
    \u0639\u0645\u0644\u062A\u0647\u0627 \u0642\u0628\u0644 \u0643\u062F\u0647."
  - "\u0643\u0644 \u062E\u0637 \u0644\u064A\u0647 \u0643\u0648\u062F \u0639\u0644\u0649
    \u0644\u0648\u062D\u0629 \u0627\u0644\u0645\u0648\u0627\u0639\u064A\u062F. C1
    \u0627\u0644\u0648\u0631\u0634\u0629\u060C \u0648R3 \u0645\u0643\u0627\u0646
    \u0627\u0644\u0633\u0645\u0643."
  - "\u0627\u0644\u0623\u062A\u0648\u0628\u064A\u0633 \u0628\u064A\u0631\u0648\u062D
    \u0627\u0644\u0644\u064A \u062A\u0642\u0648\u0644\u0647. \u0645\u0627\u0644\u0648\u0634
    \u0631\u0623\u064A \u0641\u064A \u062E\u0637\u062A\u0643 \u0627\u0644\u062A\u062C\u0627\u0631\u064A\u0629."
  - "\u0627\u062A\u0643\u0644\u0645 \u0645\u0639 \u0627\u0644\u062A\u0627\u062C\u0631
    \u0628\u0635\u0648\u062A \u0639\u0627\u0644\u064A. \u0625\u0646\u0643 \u062A\u0628\u0635\u0644\u0647
    \u0628\u0645\u0639\u0646\u0649 \u0645\u0634 \u0647\u064A\u0646\u0632\u0651\u0644
    \u0627\u0644\u0633\u0639\u0631."
  - "\u0627\u0644\u062A\u0627\u062C\u0631 \u0645\u062D\u062A\u0627\u062C \u0627\u0644\u0645\u0627\u064A\u0643
    \u0639\u0634\u0627\u0646 \u064A\u0633\u0645\u0639\u0643. \u0627\u0644\u0645\u0648\u0636\u0648\u0639
    \u0645\u0634 \u0645\u062E\u064A\u0641 \u0632\u064A \u0645\u0627 \u0628\u064A\u0628\u0627\u0646."
  - "\u0627\u0644\u063A\u0631\u0627 \u0628\u064A\u0644\u0632\u0651\u0642 \u0642\u0637\u0639\u062A\u064A\u0646.
    \u0648\u0628\u064A\u0644\u0632\u0651\u0642 \u0627\u0644\u063A\u0644\u0637 \u0628\u0646\u0641\u0633
    \u0627\u0644\u062D\u0645\u0627\u0633\u060C \u064A\u0628\u0642\u0649 \u0631\u0643\u0651\u0632."
  - "\u0627\u062E\u062A\u0627\u0631 \u0627\u0644\u0631\u0633\u0645\u0629 \u0642\u0628\u0644
    \u0645\u0627 \u062A\u0628\u062F\u0623 \u062A\u0642\u0637\u0639. \u0627\u0644\u0627\u0631\u062A\u062C\u0627\u0644
    \u0628\u064A\u0636\u064A\u0651\u0639 \u062E\u0634\u0628."
  - "\u0627\u0644\u0634\u0646\u0637\u0629 \u0628\u062A\u0634\u064A\u0644 \u0627\u0644\u0644\u064A
    \u062A\u062D\u0637\u0647 \u0641\u064A\u0647\u0627. \u0627\u062E\u062A\u0631\u0627\u0639
    \u0639\u0638\u064A\u0645\u060C \u0639\u0627\u0631\u0641\u064A\u0646."
  - "\u0628\u0635\u0651 \u0639\u0644\u0649 \u0645\u0639\u0635\u0645\u0643 \u0644\u0645\u0627
    \u062A\u0646\u0633\u0649 \u0627\u0646\u062A \u0643\u0646\u062A \u0628\u062A\u0639\u0645\u0644
    \u0625\u064A\u0647."
  - "\u0627\u0644\u0644\u0639\u0628\u0629 \u0643\u0644\u0647\u0627 \u0628\u062A\u062A\u0643\u0644\u0645
    \u0639\u0631\u0628\u064A. \u0627\u0644\u0625\u0639\u062F\u0627\u062F\u0627\u062A\u060C
    \u0627\u0644\u0644\u063A\u0629\u060C \u0648\u062E\u0644\u0627\u0635."
  - "\u0641\u064A \u0633\u062A \u0623\u0646\u0648\u0627\u0639 \u0633\u0645\u0643
    \u0628\u0631\u0647. \u0627\u0639\u0631\u0641 \u0645\u064A\u0646 \u0641\u064A\u0647\u0645
    \u0627\u0644\u0644\u064A \u0628\u064A\u062F\u0641\u0639 \u0627\u0644\u0625\u064A\u062C\u0627\u0631."
  - "\u0643\u0644 \u0633\u0644\u0627\u064A\u062F\u0631 \u0641\u064A \u0627\u0644\u0625\u0639\u062F\u0627\u062F\u0627\u062A
    \u0628\u064A\u0639\u0645\u0644 \u062D\u0627\u062C\u0629. \u0623\u064A\u0648\u0647\u060C
    \u062D\u062A\u0649 \u062F\u0647."
  - "\u062F\u0645\u064A\u0627\u0637 \u0628\u062A\u0639\u0645\u0644 \u0645\u0648\u0628\u064A\u0644\u064A\u0627
    \u0645\u0646 \u0633\u062A\u0645\u064A\u0629 \u0633\u0646\u0629. \u0645\u0641\u064A\u0634
    \u0636\u063A\u0637 \u062E\u0627\u0644\u0635."
  - "\u0627\u0644\u0645\u0631\u0643\u0628 \u0628\u062A\u0627\u062E\u062F \u0642\u0637\u0639\u0629
    \u0648\u0627\u062D\u062F\u0629 \u0641\u064A \u0643\u0644 \u0645\u0643\u0627\u0646.
    \u0645\u0634 \u0647\u062A\u0627\u062E\u062F \u0627\u062A\u0646\u064A\u0646 \u0645\u0647\u0645\u0627
    \u062A\u0632\u0642\u0651."
  - "\u062E\u062F \u0628\u0627\u0644\u0643 \u0645\u0646 \u0627\u0644\u0639\u0641\u0634
    \u0627\u0644\u0644\u064A \u0641\u064A \u0623\u0648\u0636\u062A\u0643 \u0627\u0644\u062D\u0642\u064A\u0642\u064A\u0629.
    \u0627\u0644\u0648\u0631\u0634\u0629 \u0645\u0634 \u0645\u0633\u0624\u0648\u0644\u0629."
  - "\u062A\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0623\u0648\u0644 \u0633\u0639\u0631\u061F
    \u0645\u0633\u0645\u0648\u062D. \u0628\u0633 \u0646\u0627\u062F\u0631\u0627\u064B
    \u0645\u0627 \u064A\u0643\u0648\u0646 \u0623\u062D\u0633\u0646 \u0634\u063A\u0644\u0643."
  - "\u0627\u0644\u062E\u0634\u0628 \u0645\u0634 \u0628\u064A\u0637\u0644\u0639 \u062A\u0627\u0646\u064A
    \u0639\u0644\u0649 \u0627\u0644\u062A\u0631\u0627\u0628\u064A\u0632\u0629. \u0627\u0642\u0637\u0639
    \u0648\u0627\u0646\u062A \u0648\u0627\u062E\u062F \u0628\u0627\u0644\u0643."
  - "\u0627\u0644\u0633\u0645\u0643\u0629 \u0627\u0644\u0644\u064A \u0627\u0635\u0637\u062F\u062A\u0647\u0627
    \u0627\u0644\u0635\u0628\u062D \u0628\u062A\u0641\u0627\u0635\u0644 \u0623\u062D\u0633\u0646
    \u0645\u0646 \u0628\u062A\u0627\u0639\u0629 \u0625\u0645\u0628\u0627\u0631\u062D."
  - "\u0644\u0648 \u062F\u0631\u0627\u0639\u0643 \u0648\u062C\u0639\u0643\u060C \u062F\u064A
    \u0645\u0634 \u0645\u064A\u0643\u0627\u0646\u064A\u0643\u0629 \u0641\u064A \u0627\u0644\u0644\u0639\u0628\u0629.
    \u0642\u0648\u0645 \u0627\u0642\u0639\u062F \u0634\u0648\u064A\u0629."
